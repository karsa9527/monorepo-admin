{
  "name": "@office-admin/lib",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "description": "Office 前端基础库：工具函数、请求层、约定式路由核心",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./request": {
      "types": "./src/request/index.ts",
      "import": "./src/request/index.ts"
    },
    "./hooks": {
      "types": "./src/hooks/use-request.ts",
      "import": "./src/hooks/use-request.ts"
    },
    "./router": {
      "types": "./src/router/index.ts",
      "import": "./src/router/index.ts"
    }
  },
  "types": "./src/index.ts",
  "files": [
    "src"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext .js,.cjs,.mjs,.ts,.tsx",
    "lint:fix": "npm run lint -- --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "peerDependencies": {
    "@ant-design/icons": "^5.0.0",
    "axios": "^1.0.0",
    "dayjs": "^1.11.0",
    "react": ">=18",
    "react-router-dom": ">=6"
  },
  "devDependencies": {
    "@ant-design/icons": "^5.5.1",
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@typescript-eslint/eslint-plugin": "^8.71.2",
    "@typescript-eslint/parser": "^8.71.2",
    "axios": "^1.7.7",
    "dayjs": "^1.11.13",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-react-refresh": "^0.4.14",
    "lint-staged": "^15.2.10",
    "prettier": "^3.3.3",
    "react": "^18.3.1",
    "react-router-dom": "^6.27.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  }
}
