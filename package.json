{
  "name": "monorepo-admin",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Office 前端单仓工程（npm workspaces）：共享包 + 多套后台应用",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=18.18"
  },
  "scripts": {
    "postinstall": "npm run build:mock",
    "build:mock": "npm run build -w @office/mock",
    "dev:mock": "npm run dev -w @office/mock",
    "dev:one": "npm run dev -w @office/admin-one",
    "dev:two": "npm run dev -w @office/admin-two",
    "build": "npm run build -w @office/admin-one && npm run build -w @office/admin-two",
    "build:one": "npm run build -w @office/admin-one",
    "build:two": "npm run build -w @office/admin-two",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint . --ext .js,.cjs,.mjs,.ts,.tsx",
    "lint:fix": "npm run lint -- --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky || true"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@typescript-eslint/eslint-plugin": "^8.71.2",
    "@typescript-eslint/parser": "^8.71.2",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-react-refresh": "^0.4.14",
    "husky": "^9.1.6",
    "lint-staged": "^15.2.10",
    "prettier": "^3.3.3",
    "typescript": "^5.6.3"
  },
  "volta": {
    "node": "20.20.2"
  }
}
